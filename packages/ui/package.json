{
  "name": "@morpheme/ui",
  "version": "1.0.1",
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly && mv dist/src dist/types",
    "prepublishOnly": "pnpm run build",
    "test": "vitest"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.13",
    "@morpheme/theme": "^1.0.0",
    "@morpheme/utils": "^1.0.0",
    "@morpheme/tailwind-config": "^1.0.0",
    "@morpheme/tailwind-components": "^1.0.0",
    "@morpheme/themes": "^1.0.0",
    "@vueuse/core": "^10.11.0",
    "floating-vue": "^2.0.0-beta.20",
    "pagino": "^1.4.2",
    "vee-validate": "^4.13.1",
    "vue": "^3.4.31",
    "vue-router": "^4.4.0",
    "yup": "^1.4.0",
    "@vue/test-utils": "^2.0.0-rc.17",
    "sass": "^1.58.3"
  },
  "main": "./dist/ui.umd.js",
  "unpkg": "./dist/ui.iife.js",
  "jsdelivr": "./dist/ui.iife.js",
  "module": "./dist/ui.mjs",
  "types": "./dist/types/index.d.ts",
